diff --git a/packages/core/test/sca-overlay.test.ts b/packages/core/test/sca-overlay.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/test/sca-overlay.test.ts
@@ -0,0 +1,46 @@
+import { afterEach, expect, test } from "bun:test"
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import { load, description } from "../src/sca-overlay.js"
+import { make, render } from "../src/session/system-prompt.js"
+
+const previous = process.env.SCA_AGENT_OVERLAY
+const directory = mkdtempSync(join(tmpdir(), "sca-overlay-"))
+afterEach(() => {
+  if (previous === undefined) delete process.env.SCA_AGENT_OVERLAY
+  else process.env.SCA_AGENT_OVERLAY = previous
+  rmSync(join(directory, "overlay.json"), { force: true })
+})
+function overlay(value: unknown) {
+  const path = join(directory, "overlay.json")
+  writeFileSync(path, JSON.stringify(value))
+  process.env.SCA_AGENT_OVERLAY = path
+}
+
+test("absent and empty overlays preserve prompt bytes", () => {
+  delete process.env.SCA_AGENT_OVERLAY
+  const original = make(["shell", "edit"])
+  process.env.SCA_AGENT_OVERLAY = join(directory, "missing")
+  expect(make(["shell", "edit"])).toBe(original)
+  overlay({})
+  expect(make(["shell", "edit"])).toBe(original)
+  expect(description("read", "original")).toBe("original")
+})
+test("overrides prompt, guidance, and descriptions including empty strings", () => {
+  overlay({ system_prompt: "Custom ${OPENCODE_TOOL_GUIDANCE}", tool_guidance: "$& guidance",
+    tool_descriptions: { read: "", shell: "Custom shell" } })
+  expect(make(["shell"])).toBe("Custom $& guidance")
+  expect(description("read", "original")).toBe("")
+  expect(description("shell", "original")).toBe("Custom shell")
+  expect(description("write", "original")).toBe("original")
+  overlay({ system_prompt: "Custom", tool_guidance: "guidance" })
+  expect(make([])).toBe("Custom\n\nguidance")
+  overlay({ tool_guidance: "" })
+  expect(render("${OPENCODE_TOOL_GUIDANCE}", ["shell"])).toBe("")
+})
+test("invalid JSON fails with a clear error", () => {
+  overlay({})
+  writeFileSync(process.env.SCA_AGENT_OVERLAY!, "{")
+  expect(load).toThrow("SCA_AGENT_OVERLAY: invalid JSON")
+})
